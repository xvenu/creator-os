APP_NAME=ZozaFactory
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8001
API_PREFIX=/api/v1
# SQLite by default (relocatable, self-contained). Postgres optional:
# DATABASE_URL=postgresql+psycopg2://zoza:zoza@localhost:5432/zozafactory
DATABASE_URL=sqlite:///./factory.db
OUTPUT_DIR=./output
# Reality-first tuning
REALITY_MIN_TRUST=0.6
# Shared Creator-OS bus forwarding (opt-in; local outbox always records).
#ZOZAFACTORY_SHARED_BUS=1
