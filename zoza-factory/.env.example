APP_NAME=ZozaFactory
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8001
API_PREFIX=/api/v1
# SQLite by default (relocatable, self-contained). Postgres optional:
# DATABASE_URL=postgresql+psycopg2://zoza:zoza@localhost:5432/zozafactory
DATABASE_URL=sqlite:///./factory.db
OUTPUT_DIR=./output
# Reality-first tuning
REALITY_MIN_TRUST=0.6
# Shared Creator-OS bus forwarding (opt-in; local outbox always records).
#ZOZAFACTORY_SHARED_BUS=1
# Render provider: local-ffmpeg (default production) | runpod | simulated (tests only).
RENDER_PROVIDER=local-ffmpeg
RENDER_FPS=24
# RunPod GPU (production workloads; unset = runpod unavailable, explicit error).
#RUNPOD_API_KEY=
#RUNPOD_ENDPOINT_ID=
#RUNPOD_TIMEOUT_SECONDS=600
# Storage: local (default) | s3 (requires bucket + AWS-style creds in env).
#STORAGE_BACKEND=local
#STORAGE_S3_BUCKET=
#STORAGE_S3_PREFIX=zoza-exports/
#STORAGE_S3_ENDPOINT=
# Factory auth (production: set all three; dev: empty = auth disabled).
#PULSE_TOKEN_MUSIC=
#PULSE_TOKEN_FOOTBALL=
#FACTORY_ADMIN_TOKEN=
