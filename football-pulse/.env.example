APP_NAME=FootballPulse V2
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://football:football@localhost:5432/footballpulse
REDIS_URL=redis://localhost:6379/0
# Zoza Video Factory (Creator-OS refactor): pulse never renders locally.
# ZOZA_DIR points at the factory checkout (jobs/ file queue). Unset =
# auto-detect (../Zoza_anime, ~/Zoza_anime). Missing dir = retryable queued.
#ZOZA_DIR=/path/to/Zoza_anime
# Shared Creator-OS event bus forwarding (opt-in; local outbox always records).
#FOOTBALLPULSE_SHARED_BUS=1
# Secrets (never commit real values — inject via environment / Docker secrets):
# YOUTUBE_API_KEY=
# TIKTOK_API_KEY=
# OPENAI_API_KEY=
